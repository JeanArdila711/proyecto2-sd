# Copiar a config.env (ignorado por git) y ajustar.
#   cp config.example.env config.env

# Perfil de la AWS CLI con las credenciales del Learner Lab (AWS Details → AWS CLI).
AWS_PROFILE=academy
AWS_REGION=us-east-1

# Contraseña del usuario maestro de MariaDB. Si queda vacía, punto2-fuentes/infra/crear_infra.py
# genera una y la escribe aquí.
DB_PASSWORD=

# Rango que puede entrar por SSH a la EC2. Vacío = tu IP pública actual (/32).
SSH_CIDR=
